rules_version = '2';
// Duar Stok Yönetim — Firestore güvenlik kuralları.
// Yalnızca e-postası doğrulanmış yönetici veya yöneticinin eklediği
// kullanıcılar veri okuyup yazabilir. Stok hareketleri değiştirilemez/silinemez.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner() {
      return signedIn() && request.auth.token.email == 'tektas590@gmail.com';
    }
    function member() {
      return owner() || (signedIn() && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)));
    }

    match /allowedUsers/{email} {
      allow read: if owner() || (signedIn() && request.auth.token.email == email);
      allow write: if owner();
    }
    match /items/{id} { allow read, write: if member(); }
    match /invoices/{id} { allow read, create, update: if member(); }
    match /issues/{id} { allow read, create, update: if member(); }
    match /counts/{id} { allow read, create: if member(); }
    match /movements/{id} { allow read, create: if member(); }
  }
}
